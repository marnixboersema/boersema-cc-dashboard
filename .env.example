# Stel hierdie waardes in Vercel se "Environment Variables"-paneel.
# Vir lokale toets: kopieer na .env en hardloop met `vercel dev`.

AIRTABLE_PAT=patXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXX

# Die enkele, gedeelde wagwoord wat die hele dashboard sluit (geen gebruikersnaam).
# Kies iets sterk. Verander dit hier (en herontplooi) om almal uit te skop.
DASHBOARD_PASSWORD=kies-n-sterk-wagwoord
